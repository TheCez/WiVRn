index 801a294e1..0ba0a6d19 100644
--- a/src/external/openxr_includes/openxr/openxr.h
+++ b/src/external/openxr_includes/openxr/openxr.h
@@ -3446,6 +3446,15 @@ typedef struct XrInteractionProfileDpadBindingEXT {
 
 
 
+// XR_VALVE_frame_controller_interaction is a preprocessor guard. Do not pass it to API calls.
+// Not yet in the public Khronos registry as of this writing -- name and
+// interaction profile/component paths verified against Valve's own published
+// com.valvesoftware.openxr.utils package docs (github.com/ValveSoftware/Unity).
+// Pure interaction-profile extension: no new structs, enums or functions.
+#define XR_VALVE_frame_controller_interaction 1
+#define XR_VALVE_frame_controller_interaction_SPEC_VERSION 1
+#define XR_VALVE_FRAME_CONTROLLER_INTERACTION_EXTENSION_NAME "XR_VALVE_frame_controller_interaction"
+
 // XR_VALVE_analog_threshold is a preprocessor guard. Do not pass it to API calls.
 #define XR_VALVE_analog_threshold 1
 #define XR_VALVE_analog_threshold_SPEC_VERSION 2
