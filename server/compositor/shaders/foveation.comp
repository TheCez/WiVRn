#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Chroma is averaged over each 2x2 luma block by gathering the 4 relevant
// invocations' already-computed colour through workgroup shared memory,
// indexed by gl_LocalInvocationIndex (spec-guaranteed portable: exactly
// LocalInvocationID.z*sizeY*sizeX + LocalInvocationID.y*sizeX +
// LocalInvocationID.x, no subgroup involvement at all). This used to be
// done with subgroupShuffleDown, using
// `id = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID` for the
// coordinate remap too, which silently assumes that value equals
// gl_LocalInvocationIndex -- true on desktop AMD/NVIDIA (subgroup size
// 32/64 divides the 8x8=64 workgroup evenly, in raster order) but NOT on
// this device: measured live, VkPhysicalDeviceSubgroupProperties reports
// subgroupSize=128, larger than the entire 64-invocation workgroup, so
// the "reconstruct LocalInvocationIndex from subgroup IDs" trick has no
// guarantee of producing 0..63 in the expected order at all. This is
// consistent with every piece of evidence gathered chasing the
// green/corrupted-chroma bug (see docs/ANDROID_PORT.md's Milestone 4.5):
// large regions of the chroma (and even luma, on the stream with the
// most affected eye) plane captured directly from the pre-MediaCodec
// host buffer were never written at all (literal zero bytes), at a
// deterministic, identical-every-frame cutoff -- exactly what a broken
// id->(ix,iy) mapping produces (some destination pixels never receive a
// valid id at all), not what a data race or driver timing bug would look
// like.
shared vec4 tile[gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z];

#define MAX_DIM 4097
#define MAX_SAMPLES 4

layout(set = 0, binding = 0) uniform sampler2D source[2];
layout(set = 0, binding = 1, std430) buffer restrict Config
{
	// foveation parameters
	uint x[2*MAX_DIM];
	uint y[2*MAX_DIM];
} ubo;

layout(set = 0, binding = 2) uniform writeonly restrict image2DArray luma;
layout(set = 0, binding = 3) uniform writeonly restrict image2DArray chroma;
// Alpha's own dedicated destination (previously array layer 2 of the same
// image as luma/chroma; now its own single-layer image, still shared
// between both eyes via the same x-offset packing as before). Only written
// when alpha_width>0; harmless to bind even when unused.
layout(set = 0, binding = 4) uniform writeonly restrict image2DArray alpha_luma;
layout(set = 0, binding = 5) uniform writeonly restrict image2DArray alpha_chroma;

layout(constant_id = 0) const int alpha_width = 0;

// Each dispatch now targets ONE eye's own dedicated single-array-layer
// destination image (see compositor.h's struct image comment for why:
// a real GPU driver bug on this hardware corrupts compute writes to array
// layer >=1 of a multi-planar image). gl_GlobalInvocationID.z is therefore
// always 0 -- which eye's ubo/source-array slot to read now comes from this
// push constant instead.
layout(push_constant) uniform PushConstants
{
	int eye;
} pc;

const mat3 color_space = mat3(
//         R        G        B
/* Y */ 0.2126,  0.7152,  0.0722,
/* Cb*/-0.1146, -0.3854,  0.5,
/* Cr*/ 0.5   , -0.4542, -0.0458);

vec3 rgb_to_ycbcr(vec3 color)
{
	return transpose(color_space) * color + vec3(0, 0.5, 0.5);
}

float from_linear_to_srgb_channel(float value)
{
	if (value < 0.0031308) {
		return 12.92 * value;
	} else {
		return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
	}
}

vec3 from_linear_to_srgb(vec3 linear_rgb)
{
	return vec3(
		from_linear_to_srgb_channel(linear_rgb.r),
		from_linear_to_srgb_channel(linear_rgb.g),
		from_linear_to_srgb_channel(linear_rgb.b)
	);
}

uint ABfe(uint src,uint off,uint bits){return bitfieldExtract(src,int(off),int(bits));}
uint ABfiM(uint src,uint ins,uint bits){return bitfieldInsert(src,ins,0,int (bits));}
 // More complex remap 64x1 to 8x8 which is necessary for 2D wave reductions.
 //  543210
 //  ======
 //  .xx..x
 //  y..yy.
 // Details,
 //  LANE TO 8x8 MAPPING
 //  ===================
 //  00 01 08 09 10 11 18 19
 //  02 03 0a 0b 12 13 1a 1b
 //  04 05 0c 0d 14 15 1c 1d
 //  06 07 0e 0f 16 17 1e 1f
 //  20 21 28 29 30 31 38 39
 //  22 23 2a 2b 32 33 3a 3b
 //  24 25 2c 2d 34 35 3c 3d
 //  26 27 2e 2f 36 37 3e 3f
 uint ARmpRed8x8_x(uint a){return ABfiM(ABfe(a,2u,3u),a,1u);}
 uint ARmpRed8x8_y(uint a){return ABfiM(ABfe(a,3u,3u),ABfe(a,1u,2u),2u);}
 //uvec2 ARmpRed8x8(uint32_t a){return uvec2(ABfiM(ABfe(a,2u,3u),a,1u),ABfiM(ABfe(a,3u,3u),ABfe(a,1u,2u),2u));}

void main()
{
	uint iz = uint(pc.eye);

	uint id = gl_LocalInvocationIndex;
	uint iy = gl_WorkGroupID.y * gl_WorkGroupSize.y + ARmpRed8x8_y(id);
	uint ix = gl_WorkGroupID.x * gl_WorkGroupSize.x + ARmpRed8x8_x(id);

	uint ymin = ubo.y[MAX_DIM * iz + iy];
	uint ymax = ubo.y[MAX_DIM * iz + iy + 1];
	if (ymin > ymax)
	{
		uint tmp = ymin;
		ymin = ymax;
		ymax = tmp;
	}

	uint xmin = ubo.x[MAX_DIM * iz + ix];
	uint xmax = ubo.x[MAX_DIM * iz + ix + 1];

	uint xstep = (xmax - xmin + MAX_SAMPLES - 1) / MAX_SAMPLES;
	uint ystep = (ymax - ymin + MAX_SAMPLES - 1) / MAX_SAMPLES;

	vec4 colour = vec4(0);
	uint count = 0;
	for (uint y = ymin ; y < ymax; y += ystep) {
		for (uint x = xmin ; x < xmax; x += xstep) {
			colour += texelFetch(source[iz], ivec2(x, y), 0);
			++count;
		}
	}
	colour /= max(count, 1);
	colour.xyz = rgb_to_ycbcr(from_linear_to_srgb(colour.rgb));

	imageStore(luma, ivec3(ix, iy, 0), vec4(colour.x));

	tile[id] = colour;
	barrier();

	if ((id % 4)== 0)
	{
		vec4 sum = tile[id] + tile[id + 1] + tile[id + 2] + tile[id + 3];

		// actual chroma
		imageStore(chroma, ivec3(ix/2, iy/2, 0), vec4(sum.y, sum.z, 0, 0) / 4);

		if (alpha_width > 0)
		{
			// alpha in luma -- own dedicated image now, same x-offset packing
			// as before (both eyes share it), just always layer 0.
			int offset = alpha_width * int(iz);
			imageStore(alpha_luma, ivec3(offset + ix/2, iy/2, 0), vec4(sum.w, 0, 0, 0) / 4);
			imageStore(alpha_chroma, ivec3(offset + ix/2, iy/2, 0), vec4(0.5, 0.5, 0, 0));
		}
	}
}
