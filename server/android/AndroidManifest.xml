<?xml version="1.0" encoding="utf-8"?>
<!--
  DRAFT -- not yet wired into a real Gradle module. This is what the
  server-side Android app's manifest needs to contain; it should be merged
  into a real AndroidManifest.xml once a Gradle module exists for it (see
  docs/ANDROID_PORT.md, "Milestone 2" -> next step). Written against the
  same Vulkan/OpenXR feature requirements as the root (client) manifest,
  since wivrn-server needs the same Vulkan capability the client does.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.meumeu.wivrn.server">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="true"/>
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true"/>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- CHANGE_WIFI_MULTICAST_STATE is for the future NsdManager-based
         Avahi replacement (mDNS needs multicast); not used yet. -->

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Streaming to a headset is squarely what Android's "connectedDevice"
         foreground service type is for -- already confirmed working on
         this exact device for org.freedesktop.monado.openxr_runtime's own
         out-of-process runtime broker service (observed in adb logcat
         during earlier device testing), so reusing the same category here
         rather than guessing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="WiVRn Server">

        <service
            android:name="org.meumeu.wivrn.server.WivrnServerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
